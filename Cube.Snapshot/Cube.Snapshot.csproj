<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Dev-only tool (PROJECT.md, "Automated testing": snapshot renderer). Turns a draw list dumped by the in-game
    test bridge into a PNG so the frame can be looked at. Not shipped, and not referenced by the plugin.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core is Dalamud-free; the demo mode renders Core's output without the game. -->
    <ProjectReference Include="..\Cube.Core\Cube.Core.csproj" />
  </ItemGroup>

</Project>
