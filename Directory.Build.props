<Project>
  <!--
    Code is the documentation (CLAUDE.md / PROJECT.md): the "how it works" docs are generated by DocFX
    from XML doc comments, so missing or broken comments fail the build.
    - CS1591/CS1573/CS1574 cover public members and broken references.
    - StyleCop's documentation rules (configured in stylecop.json and .editorconfig) extend that to
      internal and private code. All other StyleCop rule categories are switched off.
  -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591;CS1573;CS1574;CS1572;CS1584;CS1658</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers" Version="1.3.180" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)stylecop.json" Link="stylecop.json" Visible="false" />
  </ItemGroup>
</Project>
